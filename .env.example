# ─────────────────────────────────────────────────────────────
#  Supabase 연결 설정 — 빈 서식
#
#  이 파일은 "어떤 값이 필요한지"만 알려 주는 견본입니다.
#  값은 비워 두고, 이 파일만 git 에 올립니다.
#
#  실제 값은 옆에 있는 .env.local 에 적어 주세요.
#  (.env.local 은 .gitignore 가 막고 있어 레포지토리에 올라가지 않습니다)
#
#  값 넣는 곳 — Supabase 홈페이지 → 내 프로젝트 → 왼쪽 아래 Settings
#               → API Keys / Data API 화면
# ─────────────────────────────────────────────────────────────

# 프로젝트 주소 (Project URL) — https://xxxxxxxx.supabase.co 모양입니다
VITE_SUPABASE_URL=

# 공개용 열쇠 (Publishable key / anon public)
# ⚠️ 반드시 '공개용'을 넣으세요. secret · service_role 열쇠는 절대 넣지 않습니다.
#    이 값은 방문자 브라우저까지 그대로 전달되기 때문입니다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# 사진·영상을 담아 둘 저장소(Storage) 통 이름 — 예: projects
VITE_SUPABASE_STORAGE_BUCKET=
